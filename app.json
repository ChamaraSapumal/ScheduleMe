{
  "expo": {
    "name": "ScheduleMe",
    "slug": "ScheduleMe",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splashdesign.png",
      "resizeMode": "cover",
      "backgroundColor": "#3E315A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3E315A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sapuxcreation.ScheduleMe",
      "googleServicesFile": "./google-services.json"
    },
    "notification": {
      "icon": "./assets/notification_icon.png",
      "color": "#3E315A",
      "iosDisplayInForeground": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "enablePngCrunch": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fbf8c3b7-7bdf-451e-b443-2b85ea2df43b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fbf8c3b7-7bdf-451e-b443-2b85ea2df43b"
    }
  }
}